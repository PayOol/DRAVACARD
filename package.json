{
  "name": "nextjs-shadcn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "preview:pwa": "node scripts/preview-pwa.mjs",
    "build": "next build && node scripts/generate-pwa.mjs",
    "lint": "biome lint . && tsc --noEmit",
    "format": "biome format --write .",
    "worker:test": "npm --prefix worker test",
    "worker:check": "npm --prefix worker run types && npm --prefix worker run check",
    "worker:build": "npm --prefix worker run build",
    "worker:deploy": "npm --prefix worker run deploy",
    "test:payments": "node --test scripts/leekpay-client.test.mjs scripts/payment-api.test.mjs scripts/provider-dialog.test.mjs scripts/checkout-shell.test.mjs scripts/customer-location.test.mjs scripts/payment-result.test.mjs scripts/catalog-sections.test.mjs",
    "test:theme": "node --test scripts/theme.test.mjs",
    "test:pwa": "node --test scripts/pwa.test.mjs scripts/pwa-install.test.mjs",
    "test:tiktok": "node --test scripts/tiktok-catalog.test.mjs scripts/tiktok-payment.test.mjs scripts/tiktok-result.test.mjs",
    "security:audit": "npm audit --audit-level=low",
    "security:source": "node scripts/security-check.mjs",
    "security:output": "node scripts/security-check.mjs --output",
    "security:test": "node scripts/security-check.mjs --self-test",
    "security:check": "npm run security:test && npm run security:audit && npm run security:source"
  },
  "engines": {
    "node": ">=24.20.0 <25.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.10",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.6.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/eslintrc": "^3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
